          "name": "List Flow Runs",
          "request": {
            "name": "List Flow Runs",
            "description": {
              "content": "Retrieves flow runs by workflow ID for a specific Power Platform environment. Returns a list of flow run records including their status, start time, end time, and trigger information. The environment must have a Microsoft Dataverse database.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "powerautomate",
                "environments",
                ":environmentId",
                "flowRuns"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "workflowId",
                  "value": "<uuid>",
                  "description": "(Required) The workflow ID to retrieve flow runs for."
                },
                {
                  "disabled": false,
                  "key": "api-version",
                  "value": "2022-03-01-preview",
                  "description": "(Required) The API version to use for this request."
